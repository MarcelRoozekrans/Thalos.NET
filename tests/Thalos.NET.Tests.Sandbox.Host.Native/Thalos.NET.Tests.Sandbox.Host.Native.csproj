<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The native smoke host: the same two lines a consumer's sandbox entry point holds, published as Native AOT by
       NativeAotSmokeTests in Thalos.NET.Tests.Sandbox.Host. PublishAot here, not on the command line, so the trim and AOT
       analyzers run on this project and Thalos.NET.Sandbox.Host, and ILC sees the whole program, as a consumer
       referencing the packages does. -->
  <PropertyGroup>
    <!-- One framework, not the inherited TargetFrameworks list: publish refuses a cross-targeting project. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Thalos.NET.Sandbox.Host\Thalos.NET.Sandbox.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- tests/Directory.Build.props adds test packages; remove them for this exe -->
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
    <PackageReference Remove="xunit" />
    <PackageReference Remove="xunit.runner.visualstudio" />
    <PackageReference Remove="coverlet.collector" />
    <PackageReference Remove="NSubstitute" />
    <PackageReference Remove="AwesomeAssertions" />
    <Using Remove="Xunit" />
    <Using Remove="AwesomeAssertions" />
  </ItemGroup>
</Project>
