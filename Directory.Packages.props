<Project>
  <ItemGroup>
    <!-- ZeroAlloc ecosystem -->
    <PackageVersion Include="ZeroAlloc.Results" Version="1.2.3" />
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="2.0.9" />
    <PackageVersion Include="ZeroAlloc.Mediator" Version="5.1.5" />
    <PackageVersion Include="ZeroAlloc.Authorization" Version="2.1.3" />
    <PackageVersion Include="ZeroAlloc.AsyncEvents" Version="1.1.4" />
    <PackageVersion Include="ZeroAlloc.StateMachine" Version="1.5.4" />
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.6.3" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="1.7.8" />
    <PackageVersion Include="ZeroAlloc.Validation.Generator" Version="1.7.8" />
    <PackageVersion Include="ZeroAlloc.Inject" Version="1.7.6" />
    <PackageVersion Include="ZeroAlloc.Inject.Generator" Version="1.7.6" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.5.3" />

    <!-- Agent framework + AI abstractions -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Anthropic" Version="12.50.0" />
    <PackageVersion Include="AI.Sentinel" Version="2.3.0" />
    <!-- Rag.NET (net10.0 only) — confined to Thalos.NET.Memory.RagNet -->
    <PackageVersion Include="Rag.NET.Abstractions" Version="1.0.0" />
    <PackageVersion Include="Rag.NET.VectorStores.PgVector" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <!-- container tests -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- native git backend — confined to Thalos.NET.Git.LibGit2Sharp -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <!-- YAML process-graph definitions — confined to Thalos.NET.Workflow -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Raw-SQL ORM + transactional outbox, PostgreSQL persistence — net10.0-only, confined to Thalos.NET.Workflow.Orm -->
    <PackageVersion Include="ZeroAlloc.ORM" Version="1.7.1" />
    <PackageVersion Include="ZeroAlloc.Outbox" Version="2.7.1" />
    <PackageVersion Include="ZeroAlloc.Outbox.Orm" Version="2.7.1" />
    <PackageVersion Include="AdoNet.Async.Adapters" Version="1.4.1" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- dotnet/extensions cadence (same as Microsoft.Extensions.AI), not the runtime 10.0.x line -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />

    <!-- Analyzers / build -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.290" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.4" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- source-text scanning only (DaedalusIndependenceTests) — not a compiler dependency of any shipping assembly -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
</Project>
