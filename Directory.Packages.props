<Project>
  <ItemGroup>
    <!-- ZeroAlloc ecosystem -->
    <PackageVersion Include="ZeroAlloc.Results" Version="1.4.5" />
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="2.3.1" />
    <PackageVersion Include="ZeroAlloc.Mediator" Version="6.6.5" />
    <PackageVersion Include="ZeroAlloc.Authorization" Version="2.1.8" />
    <PackageVersion Include="ZeroAlloc.AsyncEvents" Version="1.1.12" />
    <PackageVersion Include="ZeroAlloc.StateMachine" Version="1.7.0" />
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.12.7" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="2.5.0" />
    <PackageVersion Include="ZeroAlloc.Inject" Version="1.11.5" />
    <PackageVersion Include="ZeroAlloc.Inject.Generator" Version="1.11.5" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.12.0" />

    <!-- Agent framework + AI abstractions -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.27.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- the sandbox host's MCP-over-HTTP routes — confined to Thalos.NET.Sandbox.Host -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- our own AOT-clean Anthropic Messages and Ollama embed clients; Thalos.NET.Anthropic runs on the first -->
    <PackageVersion Include="ZeroAlloc.Rest.Anthropic" Version="3.6.3" />
    <PackageVersion Include="ZeroAlloc.Rest.Ollama" Version="3.6.3" />
    <!-- the floors ZeroAlloc.Rest.Anthropic and .Ollama 3.6.0 set; ZeroAlloc.Results 1.4.5 above is theirs too -->
    <PackageVersion Include="ZeroAlloc.Rest" Version="3.6.3" />
    <PackageVersion Include="ZeroAlloc.Rest.SystemTextJson" Version="3.6.3" />
    <PackageVersion Include="ZeroAlloc.Rest.DependencyInjection" Version="3.6.3" />
    <PackageVersion Include="ZeroAlloc.Rest.Resilience" Version="3.6.3" />
    <PackageVersion Include="ZeroAlloc.Resilience" Version="3.4.0" />
    <PackageVersion Include="ZeroAlloc.Collections" Version="1.2.5" />
    <PackageVersion Include="AI.Sentinel" Version="4.2.0" />
    <!-- Rag.NET (net10.0 only) — confined to Thalos.NET.Memory.RagNet -->
    <PackageVersion Include="Rag.NET.Abstractions" Version="1.3.6" />
    <PackageVersion Include="Rag.NET.VectorStores.PgVector" Version="1.3.5" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <!-- container tests -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- native git backend — confined to Thalos.NET.Git.LibGit2Sharp -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <!-- YAML process-graph definitions — confined to Thalos.NET.Workflow -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Its source generator: the static context ProcessLoader deserializes through, so no reflection -->
    <PackageVersion Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
    <!-- Raw-SQL ORM + transactional outbox, PostgreSQL persistence — net10.0-only, confined to Thalos.NET.Workflow.Orm -->
    <PackageVersion Include="ZeroAlloc.ORM" Version="2.13.0" />
    <PackageVersion Include="ZeroAlloc.Outbox" Version="4.4.6" />
    <PackageVersion Include="ZeroAlloc.Outbox.Orm" Version="4.4.6" />
    <PackageVersion Include="AdoNet.Async.Adapters" Version="1.5.6" />
    <!-- Docker Engine client, the version Testcontainers 4.15.0 depends on — confined to Thalos.NET.Sandbox.Docker -->
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <!-- the sandbox provider's typed control client -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- dotnet/extensions cadence (same as Microsoft.Extensions.AI), not the runtime 10.0.x line -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />

    <!-- Analyzers / build -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.320" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- source-text scanning only (DaedalusIndependenceTests) — not a compiler dependency of any shipping assembly -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- runs the sandbox host in-process in its tests -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>
</Project>
