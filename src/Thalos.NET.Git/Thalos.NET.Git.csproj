<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Thalos.Git</RootNamespace>
    <PackageId>Thalos.NET.Git</PackageId>
    <Description>Local git write contract for Thalos.NET: IGitWriteService (create branch, commit, push) with no backend dependency, so a consumer can supply LibGit2Sharp (Thalos.NET.Git.LibGit2Sharp), a git-CLI shell-out, or a hosted API.</Description>
    <PackageTags>agents;git;version-control;microsoft-agent-framework;zeroalloc</PackageTags>
    <!-- LibraryImport's generated marshalling for AtomicPublish's link(2) call, as in Thalos.NET.Abstractions. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Thalos.NET\Thalos.NET.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Thalos.NET.Tests.Git" />
    <!-- The sandbox host runs its import and export git commands through GitCli's isolation rather than a second copy of it. -->
    <InternalsVisibleTo Include="Thalos.NET.Sandbox.Host" />
  </ItemGroup>
</Project>
