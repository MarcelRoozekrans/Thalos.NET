<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ZeroAlloc.Rest.Ollama 3.5.0 ships a net10.0 build only -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Thalos.Ollama</RootNamespace>
    <PackageId>Thalos.NET.Ollama</PackageId>
    <Description>Ollama embedding generator for Thalos.NET.</Description>
    <PackageTags>agents;ollama;embeddings</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ZeroAlloc.Rest.Ollama" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Thalos.NET.Tests.Unit" />
    <InternalsVisibleTo Include="Thalos.NET.Tests.Native.Probe" />
  </ItemGroup>
</Project>
