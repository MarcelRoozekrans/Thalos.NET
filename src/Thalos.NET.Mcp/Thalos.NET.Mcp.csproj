<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Thalos.Mcp</RootNamespace>
    <PackageId>Thalos.NET.Mcp</PackageId>
    <Description>Model Context Protocol servers (stdio, http) as Thalos.NET tool sources. Loads Claude Code-style .mcp.json.</Description>
    <PackageTags>agents;mcp;model-context-protocol;tools</PackageTags>
    <!-- ServerProcessTree P/Invokes the Toolhelp process snapshot; LibraryImport's generated marshalling needs this
         even where the source itself has no explicit unsafe block. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Thalos.NET\Thalos.NET.csproj" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Thalos.NET.Tests.Mcp" />
    <!-- AddRemoteRunTools registers a RemoteRunToolSource the way AddMcpServer registers a remote entry. -->
    <InternalsVisibleTo Include="Thalos.NET.Sandbox" />
    <!-- RemoteRunToolSourceTests reach the local schema source, to prove its functions cannot act. -->
    <InternalsVisibleTo Include="Thalos.NET.Tests.Sandbox" />
  </ItemGroup>
</Project>
