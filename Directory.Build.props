<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc; MA0048: file name must match type name — small related types (ids, events, notifications) are deliberately grouped per file;
         MA0158: "use System.Threading.Lock" — libraries multi-target net8.0, which has no Lock type, so plain object gates are used -->
    <NoWarn>$(NoWarn);CS1591;MA0048;MA0158</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The same NuGetAudit settings ci-baseline uses in CI, so a local restore reports the same advisories. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- $(BaseIntermediateOutputPath) is not yet defined when Directory.Build.props is imported, so spell out obj\ -->
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/obj/generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- Shared NuGet metadata; each package csproj sets PackageId/Description/PackageTags -->
  <PropertyGroup>
    <Authors>Marcel Roozekrans</Authors>
    <Copyright>Copyright (c) 2026 Marcel Roozekrans</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarcelRoozekrans/Thalos.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/Thalos.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>0.3.0</VersionPrefix>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Debugging into the package: Go to Definition and step-into show the original source.
       The PDB is embedded in each DLL, so consumers need no symbol server setting; Source Link,
       built into the .NET SDK, maps it to this commit on GitHub. ContinuousIntegrationBuild
       makes CI builds deterministic and writes /_/ paths instead of the runner's. It applies to
       the shipped projects under src/ only: in a test project it would also turn CallerFilePath
       into /_/..., which breaks tests that find snapshot files through it. -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' and $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets\logo.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="ZeroAlloc.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>
</Project>
